<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../VideoEdit/VideoEdit.fsproj" />
    <!-- widgets windowing layer (X11 + Wayland, software/SHM present). Same Renderer assembly. -->
    <ProjectReference Include="../../../widgets/platform/Platform.fsproj" />
  </ItemGroup>
</Project>
